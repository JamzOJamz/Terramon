<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\tModLoader.targets"/>

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <BuildMod>false</BuildMod>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CsvHelper" Version="33.1.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Terramon\Terramon.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="$(tMLSteamPath)$(tMLPath)"/>
        <Reference Include="$(tMLLibraryPath)/**/Hjson.dll"/>
        <Reference Include="$(tMLLibraryPath)/**/Newtonsoft.Json.dll"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Cache\**"/>
        <EmbeddedResource Remove="Cache\**"/>
        <None Remove="Cache\**"/>
    </ItemGroup>

</Project>
