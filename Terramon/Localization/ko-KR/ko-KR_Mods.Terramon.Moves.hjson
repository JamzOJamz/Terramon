	FlavorText: 새콤한 사과에서 만들어 낸 산성 액체로 공격한다. 상대의 특수방어를 떨어뜨린다.
}

GravApple: {
	DisplayName: G의힘
	FlavorText: 높은 곳에서 사과를 떨어뜨려서 데미지를 준다. 상대의 방어를 떨어뜨린다.
}

SpiritBreak: {
	DisplayName: 소울크래시
	FlavorText: 맞으면 기가 꺾여버릴 것 같은 기세로 공격한다. 상대의 특수공격을 떨어뜨린다.
}

StrangeSteam: {
	DisplayName: 원더스팀
	FlavorText: 연기를 분출해서 상대를 공격한다. 혼란시킬 때가 있다.
}

LifeDew: {
	DisplayName: 생명의물방울
	FlavorText: 신비한 물을 흩뿌려서 자신과 배틀에 나와 있는 같은 편의 HP를 회복한다.
}

Obstruct: {
	DisplayName: 블로킹
	FlavorText: 상대의 공격을 전혀 받지 않는다. 연속으로 쓰면 실패하기 쉽다. 접촉한 상대의 방어를 크게 떨어뜨린다.
}

FalseSurrender: {
	DisplayName: 사죄의찌르기
	FlavorText: 고개를 숙이는 척하면서 흐트러진 머리카락으로 찌른다. 공격은 반드시 명중한다.
}

MeteorAssault: {
	DisplayName: 스타어설트
	FlavorText: 굵은 줄기를 휘둘러서 공격한다. 단 자신도 비틀거리기 때문에 다음 턴은 움직일 수 없다.
}

Eternabeam: {
	DisplayName: 무한다이빔
	FlavorText: 본래의 모습이 된 무한다이노 최대의 공격. 다음 턴은 움직일 수 없다.
}

SteelBeam: {
	DisplayName: 철제광선
	FlavorText: 전신에서 끌어모은 강철을 빔으로 바꿔 세차게 발사한다. 자신도 데미지를 받는다.
}

ExpandingForce: {
	DisplayName: 와이드포스
	FlavorText: 사이코 파워로 상대를 공격한다. 사이코필드일 때는 위력이 오르며 모든 상대에게 데미지를 준다.
}

SteelRoller: {
	DisplayName: 아이언롤러
	FlavorText: 필드를 파괴하면서 공격한다. 필드가 어떤 상태로든 변해 있지 않은 경우 기술은 실패한다.
}

ScaleShot: {
	DisplayName: 스케일샷
	FlavorText: 비늘을 쏘아서 공격한다. 2-5회 동안 연속으로 쓴다. 스피드가 올라가지만 방어가 떨어진다.
}

MeteorBeam: {
	DisplayName: 메테오빔
	FlavorText: 1턴째에 우주의 힘을 모아서 특수공격을 올리고 2턴째에 상대를 공격한다.
}

ShellSideArm: {
	DisplayName: 셸암즈
	FlavorText: 물리와 특수 중 더 많은 데미지를 줄 수 있는 능력으로 공격한다. 독 상태로 만들 때가 있다.
}

MistyExplosion: {
	DisplayName: 미스트버스트
	FlavorText: 자신의 주위에 있는 모두를 공격하지만 사용하면 기절한다. 미스트필드일 때 위력이 올라간다.
}

GrassyGlide: {
	DisplayName: 그래스슬라이더
	FlavorText: 지면에 미끄러지듯 상대를 공격한다. 그래스필드일 때 반드시 선제공격할 수 있다.
}

RisingVoltage: {
	DisplayName: 라이징볼트
	FlavorText: 지면에서 올라오는 전격으로 공격한다. 상대가 일렉트릭필드 위에 있을 때 기술의 위력이 2배가 된다.
}

TerrainPulse: {
	DisplayName: 대지의파동
	FlavorText: 필드의 힘을 빌려서 공격한다. 사용했을 때의 필드 상태에 따라서 기술 타입과 위력이 바뀐다.
}

SkitterSmack: {
	DisplayName: 엄습하는일격
	FlavorText: 배후에서 엄습해서 공격한다. 상대의 특수공격을 떨어뜨린다.
}

BurningJealousy: {
	DisplayName: 질투의불꽃
	FlavorText: 질투의 에너지로 상대를 공격한다. 그 턴에 능력이 올라간 포켓몬을 화상 상태로 만든다.
}

LashOut: {
	DisplayName: 분풀이
	FlavorText: 상대에 대한 울분이 담긴 공격을 한다. 그 턴에 능력이 떨어져 있으면 기술의 위력이 2배가 된다.
}

Poltergeist: {
	DisplayName: 폴터가이스트
	FlavorText: 상대의 지닌 물건을 조종해서 공격한다. 상대가 도구를 지니고 있지 않으면 실패한다.
}

CorrosiveGas: {
	DisplayName: 부식가스
	FlavorText: 주위에 있는 모든 것을 강력한 산성 가스로 뒤덮어서 지니고 있는 도구를 녹여버린다.
}

Coaching: {
	DisplayName: 코칭
	FlavorText: 적절한 지도를 통해서 같은 편 전원의 공격과 방어를 올린다.
}

FlipTurn: {
	DisplayName: 퀵턴
	FlavorText: 공격한 뒤 굉장한 스피드로 돌아와서 교대 포켓몬과 교체한다.
}

TripleAxel: {
	DisplayName: 트리플악셀
	FlavorText: 3회 연속으로 킥을 날려 공격한다. 기술이 맞을 때마다 위력이 올라간다.
}

DualWingbeat: {
	DisplayName: 더블윙
	FlavorText: 날개를 상대에게 부딪쳐서 공격한다. 2회 연속으로 데미지를 준다.
}

ScorchingSands: {
	DisplayName: 열사의대지
	FlavorText: 뜨겁게 달궈진 모래를 상대에게 부딪쳐서 공격한다. 화상 상태로 만들 때가 있다.
}

JungleHealing: {
	DisplayName: 정글힐
	FlavorText: 정글과 하나가 되어 자신과 배틀에 나와 있는 같은 편의 HP와 모든 상태를 회복한다.
}

WickedBlow: {
	DisplayName: 암흑강타
	FlavorText: 악의 태세가 극에 달하여 강렬한 일격을 날린다. 반드시 급소에 맞는다.
}

SurgingStrikes: {
	DisplayName: 수류연타
	FlavorText: 물의 태세가 극에 달하여 물 흐르듯 3회의 연격을 날린다. 반드시 급소에 맞는다.
}

ThunderCage: {
	DisplayName: 썬더프리즌
	FlavorText: 전기가 흐르는 우리 안에 4-5턴 동안 상대를 가두어 공격한다.
}

DragonEnergy: {
	DisplayName: 드래곤에너지
	FlavorText: 생명력을 파워로 바꿔서 상대를 공격한다. 자신의 HP가 적을수록 기술의 위력이 떨어진다.
}

FreezingGlare: {
	DisplayName: 얼어붙는시선
	FlavorText: 두 눈에서 사이코 파워를 발사해서 공격한다. 얼음 상태로 만들 때가 있다.
}

FieryWrath: {
	DisplayName: 타오르는분노
	FlavorText: 분노를 불꽃 같은 오라로 바꿔서 공격한다. 상대를 풀죽게 만들 때가 있다.
}

ThunderousKick: {
	DisplayName: 천둥차기
	FlavorText: 번개 같은 움직임으로 상대를 농락하며 킥을 날린다. 상대의 방어를 떨어뜨린다.
}

GlacialLance: {
	DisplayName: 블리자드랜스
	FlavorText: 눈보라를 두른 얼음의 창을 상대에게 던져서 공격한다.
}

AstralBarrage: {
	DisplayName: 아스트랄비트
	FlavorText: 수많은 작은 영체를 상대에게 부딪쳐서 공격한다.
}

EerieSpell: {
	DisplayName: 섬뜩한주문
	FlavorText: 강력한 사이코 파워로 공격한다. 상대가 마지막으로 사용한 기술의 PP를 3만큼 줄인다.
}

