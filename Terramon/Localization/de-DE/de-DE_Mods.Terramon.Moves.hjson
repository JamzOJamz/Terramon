}

ClangorousSoul: {
	DisplayName: Seelentanz
	FlavorText: Der Anwender setzt eine kleine Menge an KP ein, um alle seine Statuswerte zu erhöhen.
}

BodyPress: {
	DisplayName: Body Press
	FlavorText: Der Anwender greift mit seinem ganzen Körper an. Je höher seine Verteidigung ist, desto mehr Schaden richtet er an.
}

Decorate: {
	DisplayName: Verzierung
	FlavorText: Durch Verzierungen werden der Angriff und Spezial-Angriff des Zieles stark erhöht.
}

DrumBeating: {
	DisplayName: Trommelschläge
	FlavorText: Der Anwender kontrolliert durch Trommeln Wurzeln, die das Ziel angreifen und dessen Initiative senken.
}

SnapTrap: {
	DisplayName: Fangeisen
	FlavorText: Das Ziel wird vier bis fünf Runden lang in einem Fangeisen festgehalten und angegriffen.
}

PyroBall: {
	DisplayName: Feuerball
	FlavorText: Der Anwender greift mit einem Ball aus Feuer an, den er durch Anzünden eines kleinen Steins erzeugt. Fügt dem Ziel eventuell Verbrennungen zu.
}

BehemothBlade: {
	DisplayName: Gigantenhieb
	FlavorText: Der Anwender wird zu einem riesigen Schwert und greift das Ziel an. Dynamaximierte Ziele erleiden doppelten Schaden.
}

BehemothBash: {
	DisplayName: Gigantenstoß
	FlavorText: Der Anwender wird zu einem riesigen Schild und greift das Ziel an. Dynamaximierte Ziele erleiden doppelten Schaden.
}

AuraWheel: {
	DisplayName: Aura-Rad
	FlavorText: Mithilfe der in den Backentaschen gespeicherten Energie greift der Anwender an und erhöht seine Initiative. Der Typ der Attacke hängt von Morpekos Form ab.
}

BreakingSwipe: {
	DisplayName: Breitseite
	FlavorText: Der Anwender schwingt heftig seinen robusten Schweif, um damit gegnerische Pokémon anzugreifen und ihren Angriffs-Wert zu senken.
}

BranchPoke: {
	DisplayName: Zweigstoß
	FlavorText: Der Anwender attackiert das Ziel mit einem spitzen Zweig.
}

Overdrive: {
	DisplayName: Overdrive
	FlavorText: Der Anwender haut in die Saiten seiner Gitarre oder seines Basses und erzeugt dröhnende, kraftvolle Vibrationen, die gegnerischen Pokémon schaden.
}

AppleAcid: {
	DisplayName: Apfelsäure
	FlavorText: Der Anwender greift mit einer aus einem sauren Apfel hergestellten säurehaltigen Flüssigkeit an. Dabei wird die Spezial-Verteidigung des Zieles gesenkt.
}

GravApple: {
	DisplayName: Gravitation
	FlavorText: Ein Apfel fällt aus großer Höhe herab und richtet Schaden an. Dabei wird die Verteidigung des Zieles gesenkt.
}

SpiritBreak: {
	DisplayName: Seelenbruch
	FlavorText: Die Attacke trifft das Ziel mit so viel Wucht, dass es den Mut verliert. Dabei wird sein Spezial-Angriff gesenkt.
}

StrangeSteam: {
	DisplayName: Wunderdampf
	FlavorText: Der Anwender stößt Dampf aus, mit dem er das Ziel angreift. Dieses wird eventuell verwirrt.
}

LifeDew: {
	DisplayName: Lebenstropfen
	FlavorText: Wundersames Wasser heilt die KP des Anwenders und seiner am Kampf beteiligten Mitstreiter.
}

Obstruct: {
	DisplayName: Abblocker
	FlavorText: Der Anwender wehrt jede Attacke ab. Berührt ihn währenddessen ein Pokémon, sinkt dessen Verteidigung stark. Scheitert eventuell bei Wiederholung.
}

FalseSurrender: {
	DisplayName: Kniefalltrick
	FlavorText: Der Anwender tut so, als würde er sich verneigen, und sticht dann mit seinem zerzausten Fell zu. Diese Attacke trifft immer.
}

MeteorAssault: {
	DisplayName: Sternensturm
	FlavorText: Der Anwender greift mit seiner Lauchstange an. Von der Wucht der Attacke wird ihm jedoch so schwindelig, dass er in der nächsten Runde nicht handeln kann.
}

Eternabeam: {
	DisplayName: Unendynastrahlen
	FlavorText: Der mächtigste Angriff, über den Endynalos in seiner ursprünglichen Form verfügt. In der nächsten Runde kann der Anwender nicht handeln.
}

SteelBeam: {
	DisplayName: Stahlstrahl
	FlavorText: Der Anwender schießt Stahl, den er in seinem ganzen Körper angesammelt hat, in Form eines mächtigen Strahls ab. Dabei verletzt er sich auch selbst.
}

ExpandingForce: {
	DisplayName: Flächenmacht
	FlavorText: Der Anwender greift das Ziel mit Psycho-Kräften an. Wenn ein Psychofeld aktiv ist, steigt die Stärke und es wird allen gegnerischen Pokémon Schaden zugefügt.
}

SteelRoller: {
	DisplayName: Eisenwalze
	FlavorText: Der Anwender greift an und zerstört dabei etwaige Felder. Ist kein Feld aktiv, schlägt die Attacke fehl.
}

ScaleShot: {
	DisplayName: Schuppenschuss
	FlavorText: Der Anwender greift das Ziel zwei- bis fünfmal hintereinander mit Schuppen-Geschossen an. Erhöht die eigene Initiative, aber senkt die Verteidigung.
}

MeteorBeam: {
	DisplayName: Meteorstrahl
	FlavorText: Der Anwender sammelt in Runde 1 kosmische Kräfte und erhöht damit seinen Spezial-Angriff, bevor er in Runde 2 das Ziel angreift.
}

ShellSideArm: {
	DisplayName: Muschelwaffe
	FlavorText: Je nachdem, was höher ausfällt, richtet diese Attacke entweder physischen oder Spezial-Schaden an. Das Ziel wird eventuell vergiftet.
}

MistyExplosion: {
	DisplayName: Nebelexplosion
	FlavorText: Der Anwender greift alle Pokémon im Umkreis an und wird danach kampfunfähig. Die Stärke dieser Attacke steigt, wenn ein Nebelfeld aktiv ist.
}

GrassyGlide: {
	DisplayName: Grasrutsche
	FlavorText: Der Anwender rutscht über den Boden und greift das Ziel an. Ermöglicht den Erstschlag, wenn ein Grasfeld aktiv ist.
}

RisingVoltage: {
	DisplayName: Hochspannung
	FlavorText: Der Anwender greift mit aus dem Boden aufsteigender Elektrizität an. Die Stärke der Attacke wird verdoppelt, wenn beim Gegner ein Elektrofeld aktiv ist.
}

TerrainPulse: {
	DisplayName: Feldimpuls
	FlavorText: Der Anwender nutzt die Kraft des aktiven Feldes für seinen Angriff. Der Typ und die Stärke der Attacke ändern sich je nach Art des aktiven Feldes.
}

SkitterSmack: {
	DisplayName: Krabbelkracher
	FlavorText: Der Anwender kriecht hinter das Ziel, greift es an und senkt dabei dessen Spezial-Angriff.
}

BurningJealousy: {
	DisplayName: Neidflammen
	FlavorText: Der Anwender greift mit der Energie seines Neids an und fügt allen gegnerischen Pokémon, deren Statuswerte in dieser Runde erhöht wurden, Verbrennungen zu.
}

LashOut: {
	DisplayName: Frustventil
	FlavorText: Der Anwender entlädt seinen Frust in einem Angriff. Die Stärke der Attacke wird verdoppelt, wenn seine Statuswerte in dieser Runde gesenkt wurden.
}

Poltergeist: {
	DisplayName: Poltergeist
	FlavorText: Der Anwender greift das Ziel mit dessen getragenem Item an. Die Attacke schlägt fehl, wenn das Ziel kein Item trägt.
}

CorrosiveGas: {
