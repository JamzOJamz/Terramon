SecretSword: {
	DisplayName: 神秘之剑
	FlavorText: 用长角切斩对手进行攻击。 角上拥有的神奇力量 将给予物理伤害。
}

Glaciate: {
	DisplayName: 冰封世界
	FlavorText: 将冰冻的冷气 吹向对手进行攻击。 会降低对手的速度。
}

BoltStrike: {
	DisplayName: 雷击
	FlavorText: 让强大的电流覆盖全身， 猛撞向对手进行攻击。 有时会让对手陷入麻痹状态。
}

BlueFlare: {
	DisplayName: 青焰
	FlavorText: 用美丽而激烈的青焰 包裹住对手进行攻击。 有时会让对手陷入灼伤状态。
}

FieryDance: {
	DisplayName: 火之舞
	FlavorText: 让火焰覆盖全身， 振翅攻击对手。 有时会提高自己的特攻。
}

FreezeShock: {
	DisplayName: 冰冻伏特
	FlavorText: 用覆盖着电流的冰块， 在第２回合撞向对手。 有时会让对手陷入麻痹状态。
}

IceBurn: {
	DisplayName: 极寒冷焰
	FlavorText: 用能够冻结一切的强烈冷气， 在第２回合包裹住对手。 有时会让对手陷入灼伤状态。
}

Snarl: {
