ZingZap: {
	DisplayName: 麻麻刺刺
	FlavorText: 撞向对手，并发出强电， 使其感到麻麻刺刺的。 有时会使对手畏缩。
}

NaturesMadness: {
	DisplayName: 自然之怒
	FlavorText: 向对手释放自然之怒。 对手的ＨＰ会减半。
}

MultiAttack: {
	DisplayName: 多属性攻击
	FlavorText: 一边覆盖高能量， 一边撞向对手进行攻击。 根据存储碟不同，属性会改变。
}

ZThunderbolt: {
	DisplayName: 千万伏特
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

MindBlown: {
	DisplayName: 惊爆大头
	FlavorText: 让自己的头爆炸， 来攻击周围的一切。 自己也会受到伤害。
}

PlasmaFists: {
	DisplayName: 等离子闪电拳
	FlavorText: 用覆盖着电流的拳头进行攻击。 使一般属性的招式变成电属性。
}

PhotonGeyser: {
	DisplayName: 光子喷涌
	FlavorText: 用光柱来进行攻击。 比较自己的攻击和特攻， 用数值相对较高的一项给予对方伤害。
}

