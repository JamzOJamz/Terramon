RainDance: {
	DisplayName: 求雨
	FlavorText: 在５回合内一直降雨， 从而提高水属性的招式威力。 火属性的招式威力则降低。
}

SunnyDay: {
	DisplayName: 大晴天
	FlavorText: 在５回合内让日照变得强烈， 从而提高火属性的招式威力。 水属性的招式威力则降低。
}

Crunch: {
	DisplayName: 咬碎
	FlavorText: 用利牙咬碎对手进行攻击。 有时会降低对手的防御。
}

MirrorCoat: {
	DisplayName: 镜面反射
	FlavorText: 从对手那里受到 特殊攻击的伤害将以 ２倍返还给同一个对手。
}

PsychUp: {
	DisplayName: 自我暗示
	FlavorText: 向自己施以自我暗示， 将能力变化的状态 变得和对手一样。
}

ExtremeSpeed: {
	DisplayName: 神速
	FlavorText: 以迅雷不及掩耳之势 猛撞向对手进行攻击。 必定能够先制攻击。
}

AncientPower: {
	DisplayName: 原始之力
	FlavorText: 用原始之力进行攻击。 有时会提高 自己所有的能力。
}

ShadowBall: {
	DisplayName: 暗影球
	FlavorText: 投掷一团黑影进行攻击。 有时会降低对手的特防。
}

FutureSight: {
	DisplayName: 预知未来
	FlavorText: 在使用招式２回合后， 向对手发送一团念力进行攻击。
}

RockSmash: {
	DisplayName: 碎岩
	FlavorText: 用拳头进行攻击。 有时会降低对手的防御。
}

Whirlpool: {
	DisplayName: 潮旋
	FlavorText: 将对手困在激烈的 水流旋涡中， 在４～５回合内进行攻击。
}

BeatUp: {
	DisplayName: 围攻
	FlavorText: 我方全员进行攻击。 同行的宝可梦越多， 招式的攻击次数越多。
}

FakeOut: {
	DisplayName: 击掌奇袭
	FlavorText: 进行先制攻击，使对手畏缩。 要在出场后立刻使出才能成功。
}

Uproar: {
	DisplayName: 吵闹
	FlavorText: 在３回合内 用骚乱攻击对手。 在此期间谁都不能入眠。
}

Stockpile: {
	DisplayName: 蓄力
	FlavorText: 积蓄力量， 提高自己的防御和特防。 最多积蓄３次。
}

SpitUp: {
	DisplayName: 喷出
	FlavorText: 将积蓄的力量 撞向对手进行攻击。 积蓄得越多，威力越大。
}

Swallow: {
	DisplayName: 吞下
	FlavorText: 将积蓄的力量吞下， 从而回复自己的ＨＰ。 积蓄得越多，回复越大。
}

HeatWave: {
	DisplayName: 热风
	FlavorText: 将炎热的气息 吹向对手进行攻击。 有时会让对手陷入灼伤状态。
}

Hail: {
	DisplayName: 冰雹
	FlavorText: 在５回合内一直降冰雹， 除冰属性的宝可梦以外， 给予全体宝可梦伤害。
}

Torment: {
	DisplayName: 无理取闹
	FlavorText: 向对手无理取闹， 令其不能连续２次 使出相同招式。
}

Flatter: {
	DisplayName: 吹捧
	FlavorText: 吹捧对手，使其混乱。 同时还会提高对手的特攻。
}

WillOWisp: {
	DisplayName: 鬼火
	FlavorText: 放出怪异的火焰， 从而让对手陷入灼伤状态。
}

Memento: {
	DisplayName: 临别礼物
	FlavorText: 虽然会使自己陷入濒死， 但是能够大幅降低 对手的攻击和特攻。
}

Facade: {
	DisplayName: 硬撑
	FlavorText: 当自己处于中毒、麻痹、灼伤状态时， 向对手使出此招式的话， 威力会变成２倍。
}

FocusPunch: {
	DisplayName: 真气拳
	FlavorText: 集中精神出拳。 在招式使出前 若受到攻击则会失败。
}

SmellingSalts: {
	DisplayName: 清醒
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

FollowMe: {
	DisplayName: 看我嘛
	FlavorText: 引起对手的注意， 将对手的攻击 全部转移到自己身上。
}

NaturePower: {
	DisplayName: 自然之力
	FlavorText: 用自然之力进行攻击。 根据所使用场所的不同， 使出的招式也会有所变化。
}

Charge: {
	DisplayName: 充电
	FlavorText: 提高下一回合使出的 电属性的招式威力。 自己的特防也会提高。
}

Taunt: {
	DisplayName: 挑衅
	FlavorText: 使对手愤怒。 在３回合内让对手 只能使出给予伤害的招式。
}

HelpingHand: {
	DisplayName: 帮助
	FlavorText: 帮助伙伴。 被帮助的宝可梦， 其招式威力变得比平时大。
}

Trick: {
	DisplayName: 戏法
	FlavorText: 抓住对手的空隙， 交换自己和对手的持有物。
}

RolePlay: {
	DisplayName: 扮演
	FlavorText: 扮演对手， 让自己的特性 变得和对手相同。
}

Wish: {
	DisplayName: 祈愿
	FlavorText: 在下一回合回复自己或是 替换出场的宝可梦最大ＨＰ的一半。
}

Assist: {
	DisplayName: 借助
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

Ingrain: {
	DisplayName: 扎根
	FlavorText: 在大地上扎根， 每回合回复自己的ＨＰ。 因为扎根了，所以不能替换宝可梦。
}

Superpower: {
	DisplayName: 蛮力
	FlavorText: 发挥惊人的力量攻击对手。 自己的攻击和防御会降低。
}

MagicCoat: {
	DisplayName: 魔法反射
	FlavorText: 当对手使出会变成异常状态的 招式或寄生种子等时， 会将对手的招式反射回去。
}

Recycle: {
	DisplayName: 回收利用
	FlavorText: 使战斗中已经消耗掉的 自己的持有物再生， 并可以再次使用。
}

Revenge: {
	DisplayName: 报复
	FlavorText: 如果受到对手的招式攻击， 就能给予对手２倍的伤害。
}

BrickBreak: {
	DisplayName: 劈瓦
	FlavorText: 将手刀猛烈地挥下攻击对手。 还可以破坏光墙和反射壁等。
}

Yawn: {
	DisplayName: 哈欠
	FlavorText: 打个大哈欠引起睡意。 在下一回合让对手陷入睡眠状态。
}

KnockOff: {
	DisplayName: 拍落
	FlavorText: 拍落对手的持有物， 直到战斗结束都不能使用。 对手携带道具时会增加伤害。
}

Endeavor: {
	DisplayName: 蛮干
	FlavorText: 给予伤害， 使对手的ＨＰ变得 和自己的ＨＰ一样。
}

Eruption: {
	DisplayName: 喷火
	FlavorText: 爆发怒火攻击对手。 自己的ＨＰ越少， 招式的威力越小。
}

SkillSwap: {
	DisplayName: 特性互换
	FlavorText: 利用超能力互换 自己和对手的特性。
}

Imprison: {
	DisplayName: 封印
	FlavorText: 如果对手有和自己相同的招式， 那么只有对手无法使用该招式。
}

Refresh: {
	DisplayName: 焕然一新
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

Grudge: {
	DisplayName: 怨念
	FlavorText: 因对手的招式而陷入濒死时 给对手施加怨念， 让该招式的ＰＰ变成０。
}

Snatch: {
	DisplayName: 抢夺
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

SecretPower: {
	DisplayName: 秘密之力
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

Dive: {
	DisplayName: 潜水
	FlavorText: 第１回合潜入， 第２回合浮上来进行攻击。
}

ArmThrust: {
	DisplayName: 猛推
	FlavorText: 用张开着的双手 猛推对手进行攻击。 连续攻击２～５次。
}

Camouflage: {
	DisplayName: 保护色
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

TailGlow: {
	DisplayName: 萤火
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

LusterPurge: {
	DisplayName: 洁净光芒
	FlavorText: 释放耀眼的光芒进行攻击。 有时会降低对手的特防。
}

MistBall: {
	DisplayName: 薄雾球
	FlavorText: 用围绕着雾状 羽毛的球进行攻击。 有时会降低对手的特攻。
}

FeatherDance: {
	DisplayName: 羽毛舞
	FlavorText: 撒出羽毛， 笼罩在对手的周围。 大幅降低对手的攻击。
}

TeeterDance: {
	DisplayName: 摇晃舞
	FlavorText: 摇摇晃晃地跳起舞蹈， 让自己周围的宝可梦 陷入混乱状态。
}

BlazeKick: {
	DisplayName: 火焰踢
	FlavorText: 攻击对手后， 有时会使其陷入灼伤状态。 也容易击中要害。
}

MudSport: {
	DisplayName: 玩泥巴
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

IceBall: {
	DisplayName: 冰球
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

NeedleArm: {
	DisplayName: 尖刺臂
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

SlackOff: {
	DisplayName: 偷懒
	FlavorText: 偷懒休息。 回复自己最大ＨＰ的一半。
}

HyperVoice: {
	DisplayName: 巨声
	FlavorText: 给予对手又吵又响的 巨大震动进行攻击。
}

PoisonFang: {
	DisplayName: 剧毒牙
	FlavorText: 用有毒的牙齿 咬住对手进行攻击。 有时会使对手中剧毒。
}

CrushClaw: {
	DisplayName: 撕裂爪
	FlavorText: 用坚硬的锐爪 劈开对手进行攻击。 有时会降低对手的防御。
}

BlastBurn: {
	DisplayName: 爆炸烈焰
	FlavorText: 用爆炸的火焰 烧尽对手进行攻击。 下一回合自己将无法动弹。
}

HydroCannon: {
	DisplayName: 加农水炮
	FlavorText: 向对手喷射水炮进行攻击。 下一回合自己将无法动弹。
}

MeteorMash: {
	DisplayName: 彗星拳
	FlavorText: 使出彗星般的拳头攻击对手。 有时会提高自己的攻击。
}

Astonish: {
	DisplayName: 惊吓
	FlavorText: 用尖叫声等 突然惊吓对手进行攻击。 有时会使对手畏缩。
}

WeatherBall: {
	DisplayName: 气象球
	FlavorText: 根据使用时的天气， 招式属性和威力会改变。
}

Aromatherapy: {
	DisplayName: 芳香治疗
	FlavorText: 让同伴闻沁人心脾的香气， 从而治愈我方全员的异常状态。
}

FakeTears: {
	DisplayName: 假哭
	FlavorText: 装哭流泪。 使对手不知所措， 从而大幅降低对手的特防。
}

AirCutter: {
	DisplayName: 空气利刃
	FlavorText: 用锐利的风 切斩对手进行攻击。 容易击中要害。
}

Overheat: {
	DisplayName: 过热
	FlavorText: 使出全部力量攻击对手。 使用之后会因为反作用力， 自己的特攻大幅降低。
}

OdorSleuth: {
	DisplayName: 气味侦测
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

RockTomb: {
	DisplayName: 岩石封锁
	FlavorText: 投掷岩石进行攻击。 封住对手的行动， 从而降低速度。
}

SilverWind: {
	DisplayName: 银色旋风
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

MetalSound: {
	DisplayName: 金属音
	FlavorText: 让对手听摩擦金属般 讨厌的声音。 大幅降低对手的特防。
}

GrassWhistle: {
	DisplayName: 草笛
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

Tickle: {
	DisplayName: 挠痒
	FlavorText: 给对手挠痒，使其发笑， 从而降低对手的攻击和防御。
}

CosmicPower: {
	DisplayName: 宇宙力量
	FlavorText: 汲取宇宙中神秘的力量， 从而提高自己的防御和特防。
}

WaterSpout: {
	DisplayName: 喷水
	FlavorText: 掀起潮水进行攻击。 自己的ＨＰ越少， 招式的威力越小。
}

SignalBeam: {
	DisplayName: 信号光束
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

ShadowPunch: {
	DisplayName: 暗影拳
	FlavorText: 使出混影之拳。 攻击必定会命中。
}

Extrasensory: {
	DisplayName: 神通力
	FlavorText: 发出看不见的 神奇力量进行攻击。 有时会使对手畏缩。
}

SkyUppercut: {
	DisplayName: 冲天拳
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

SandTomb: {
	DisplayName: 流沙地狱
	FlavorText: 将对手困在 铺天盖地的沙暴中， 在４～５回合内进行攻击。
}

SheerCold: {
	DisplayName: 绝对零度
	FlavorText: 给对手一击濒死。 如果是冰属性以外的宝可梦使用， 就会难以打中。
}

MuddyWater: {
	DisplayName: 浊流
	FlavorText: 向对手喷射 浑浊的水进行攻击。 有时会降低对手的命中率。
}

BulletSeed: {
	DisplayName: 种子机关枪
	FlavorText: 向对手猛烈地 发射种子进行攻击。 连续攻击２～５次。
}

AerialAce: {
	DisplayName: 燕返
	FlavorText: 以敏捷的动作 戏弄对手后进行切斩。 攻击必定会命中。
}

IcicleSpear: {
	DisplayName: 冰锥
	FlavorText: 向对手发射 锋利的冰柱进行攻击。 连续攻击２～５次。
}

IronDefense: {
	DisplayName: 铁壁
	FlavorText: 将皮肤变得坚硬如铁， 从而大幅提高自己的防御。
}

Block: {
	DisplayName: 挡路
	FlavorText: 张开双手进行阻挡， 封住对手的退路， 使其不能逃走。
}

Howl: {
	DisplayName: 长嚎
	FlavorText: 大声吼叫提高气势， 从而提高自己和同伴的攻击。
}

DragonClaw: {
	DisplayName: 龙爪
	FlavorText: 用尖锐的巨爪 劈开对手进行攻击。
}

FrenzyPlant: {
	DisplayName: 疯狂植物
	FlavorText: 用大树摔打对手进行攻击。 下一回合自己将无法动弹。
}

BulkUp: {
	DisplayName: 健美
	FlavorText: 使出全身力气绷紧肌肉， 从而提高自己的攻击和防御。
}

Bounce: {
	DisplayName: 弹跳
	FlavorText: 弹跳到高高的空中， 第２回合攻击对手。 有时会让对手陷入麻痹状态。
}

MudShot: {
	DisplayName: 泥巴射击
	FlavorText: 向对手投掷 泥块进行攻击。 同时降低对手的速度。
}

PoisonTail: {
	DisplayName: 毒尾
	FlavorText: 用尾巴拍打。 有时会让对手陷入中毒状态， 也容易击中要害。
}

Covet: {
	DisplayName: 渴望
	FlavorText: 一边可爱地撒娇， 一边靠近对手进行攻击， 还能夺取对手携带的道具。
}

VoltTackle: {
	DisplayName: 伏特攻击
	FlavorText: 让电流覆盖全身猛撞向对手。 自己也会受到不小的伤害。 有时会让对手陷入麻痹状态。
}

MagicalLeaf: {
	DisplayName: 魔法叶
	FlavorText: 散落可以追踪 对手的神奇叶片。 攻击必定会命中。
}

WaterSport: {
	DisplayName: 玩水
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

CalmMind: {
	DisplayName: 冥想
