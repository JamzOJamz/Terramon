}

CrossPoison: {
	DisplayName: 十字毒刃
	FlavorText: 用毒刃劈开对手。 有时会让对手陷入中毒状态， 也容易击中要害。
}

GunkShot: {
	DisplayName: 垃圾射击
	FlavorText: 用肮脏的垃圾 撞向对手进行攻击。 有时会让对手陷入中毒状态。
}

IronHead: {
	DisplayName: 铁头
	FlavorText: 用钢铁般 坚硬的头部进行攻击。 有时会使对手畏缩。
}

MagnetBomb: {
	DisplayName: 磁铁炸弹
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

StoneEdge: {
	DisplayName: 尖石攻击
	FlavorText: 用尖尖的岩石 刺入对手进行攻击。 容易击中要害。
}

Captivate: {
	DisplayName: 诱惑
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

StealthRock: {
	DisplayName: 隐形岩
	FlavorText: 将无数岩石悬浮在对手的周围， 从而对替换出场的对手的 宝可梦给予伤害。
}

GrassKnot: {
	DisplayName: 打草结
	FlavorText: 用草缠住并绊倒对手。 对手越重，威力越大。
}

Chatter: {
	DisplayName: 喋喋不休
	FlavorText: 用非常烦人的， 喋喋不休的音波攻击对手。 使对手混乱。
}

Judgment: {
	DisplayName: 制裁光砾
	FlavorText: 向对手放出无数的光弹。 属性会根据自己 携带的石板不同而改变。
}

BugBite: {
	DisplayName: 虫咬
	FlavorText: 咬住进行攻击。 当对手携带树果时， 可以食用并获得其效果。
}

ChargeBeam: {
	DisplayName: 充电光束
	FlavorText: 向对手发射电击光束。 由于蓄满电流， 有时会提高自己的特攻。
}

WoodHammer: {
	DisplayName: 木槌
	FlavorText: 用坚硬的躯体 撞击对手进行攻击。 自己也会受到不小的伤害。
}

AquaJet: {
	DisplayName: 水流喷射
	FlavorText: 以迅雷不及掩耳之势 扑向对手。 必定能够先制攻击。
}

AttackOrder: {
	DisplayName: 攻击指令
	FlavorText: 召唤手下， 让其朝对手发起攻击。 容易击中要害。
}

DefendOrder: {
	DisplayName: 防御指令
	FlavorText: 召唤手下， 让其附在自己的身体上。 可以提高自己的防御和特防。
}

HealOrder: {
	DisplayName: 回复指令
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

HeadSmash: {
	DisplayName: 双刃头锤
	FlavorText: 拼命使出浑身力气， 向对手进行头锤攻击。 自己也会受到非常大的伤害。
}

DoubleHit: {
	DisplayName: 二连击
	FlavorText: 使用尾巴等 拍打对手进行攻击。 连续２次给予伤害。
}

RoarOfTime: {
	DisplayName: 时光咆哮
	FlavorText: 释放出扭曲时间般的 强大力量攻击对手。 下一回合自己将无法动弹。
}

SpacialRend: {
	DisplayName: 亚空裂斩
	FlavorText: 将对手连同周围的空间一起 撕裂并给予伤害。 容易击中要害。
}

LunarDance: {
	DisplayName: 新月舞
	FlavorText: 虽然自己陷入濒死， 但可以治愈后备上场的 宝可梦的全部状态。
}

CrushGrip: {
	DisplayName: 捏碎
	FlavorText: 用骇人的力量捏碎对手。 对手剩余的ＨＰ越多， 威力越大。
}

MagmaStorm: {
	DisplayName: 熔岩风暴
	FlavorText: 将对手困在 熊熊燃烧的火焰中， 在４～５回合内进行攻击。
}

DarkVoid: {
	DisplayName: 暗黑洞
	FlavorText: 将对手强制拖入黑暗的世界， 从而让对手陷入睡眠状态。
}

SeedFlare: {
	DisplayName: 种子闪光
	FlavorText: 从身体里产生冲击波。 有时会大幅降低对手的特防。
}

OminousWind: {
	DisplayName: 奇异之风
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

ShadowForce: {
	DisplayName: 暗影潜袭
	FlavorText: 第１回合消失踪影， 第２回合攻击对手。 即使对手正受保护，也能击中。
}

HoneClaws: {
	DisplayName: 磨爪
	FlavorText: 将爪子磨得更加锋利。 提高自己的攻击和命中率。
}

WideGuard: {
	DisplayName: 广域防守
	FlavorText: 在１回合内防住 击打我方全员的攻击。
}

GuardSplit: {
	DisplayName: 防守平分
	FlavorText: 利用超能力将自己和对手的 防御和特防相加， 再进行平分。
}

PowerSplit: {
	DisplayName: 力量平分
	FlavorText: 利用超能力将自己和对手的 攻击和特攻相加， 再进行平分。
}

WonderRoom: {
	DisplayName: 奇妙空间
	FlavorText: 制造出离奇的空间。 在５回合内互换 所有宝可梦的防御和特防。
}

Psyshock: {
	DisplayName: 精神冲击
	FlavorText: 将神奇的念波实体化攻击对手。 给予物理伤害。
}

Venoshock: {
	DisplayName: 毒液冲击
	FlavorText: 将特殊的毒液泼向对手。 对处于中毒状态的对手， 威力会变成２倍。
}

Autotomize: {
	DisplayName: 身体轻量化
	FlavorText: 削掉身体上没用的部分。 大幅提高自己的速度， 同时体重也会变轻。
}

RagePowder: {
	DisplayName: 愤怒粉
	FlavorText: 将令人烦躁的粉末撒在自己身上， 用以吸引对手的注意。 使对手的攻击全部指向自己。
}

Telekinesis: {
	DisplayName: 意念移物
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

MagicRoom: {
	DisplayName: 魔法空间
	FlavorText: 制造出离奇的空间。 在５回合内所有宝可梦 携带道具的效果都会消失。
}

SmackDown: {
	DisplayName: 击落
	FlavorText: 扔石头或炮弹， 攻击飞行的对手。 对手会被击落，掉到地面。
}

StormThrow: {
	DisplayName: 山岚摔
	FlavorText: 向对手使出强烈的一击。 攻击必定会击中要害。
}

FlameBurst: {
	DisplayName: 烈焰溅射
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

SludgeWave: {
	DisplayName: 污泥波
	FlavorText: 用污泥波攻击 自己周围所有的宝可梦。 有时会陷入中毒状态。
}

QuiverDance: {
	DisplayName: 蝶舞
	FlavorText: 轻巧地跳起神秘而又美丽的舞蹈。 提高自己的特攻、特防和速度。
}

HeavySlam: {
	DisplayName: 重磅冲撞
	FlavorText: 用沉重的身体撞向对手进行攻击。 自己比对手越重，威力越大。
}

Synchronoise: {
	DisplayName: 同步干扰
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

ElectroBall: {
	DisplayName: 电球
	FlavorText: 用电气团撞向对手。 自己比对手速度越快， 威力越大。
}

Soak: {
	DisplayName: 浸水
	FlavorText: 将大量的水泼向对手， 从而使其变成水属性。
}

FlameCharge: {
	DisplayName: 蓄能焰袭
	FlavorText: 让火焰覆盖全身，攻击对手。 积蓄力量并提高自己的速度。
}

Coil: {
	DisplayName: 盘蜷
	FlavorText: 盘蜷着集中精神。 提高自己的攻击、防御和命中率。
}

LowSweep: {
	DisplayName: 下盘踢
	FlavorText: 以敏捷的动作瞄准 对手的脚进行攻击。 降低对手的速度。
}

AcidSpray: {
	DisplayName: 酸液炸弹
	FlavorText: 喷出能溶化对手的液体进行攻击。 大幅降低对手的特防。
}

FoulPlay: {
	DisplayName: 欺诈
	FlavorText: 利用对手的力量进行攻击。 正和自己战斗的对手， 其攻击越高，伤害越大。
}

SimpleBeam: {
	DisplayName: 单纯光束
	FlavorText: 向对手发送谜之念波。 接收到念波的对手， 其特性会变为单纯。
}

Entrainment: {
	DisplayName: 找伙伴
	FlavorText: 用神奇的节奏跳舞。 使对手模仿自己的动作， 从而将特性变成一样。
}

AfterYou: {
	DisplayName: 您先请
	FlavorText: 支援我方或对手的行动， 使其紧接着此招式之后行动。
}

Round: {
	DisplayName: 轮唱
	FlavorText: 用歌声攻击对手。 同伴还可以接着使出轮唱招式， 威力也会提高。
}

EchoedVoice: {
	DisplayName: 回声
	FlavorText: 用回声攻击对手。 如果每回合都有宝可梦接着 使用该招式，威力就会提高。
}

ChipAway: {
	DisplayName: 逐步击破
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

ClearSmog: {
	DisplayName: 清除之烟
	FlavorText: 向对手投掷 特殊的泥块进行攻击。 使其能力变回原点。
}

StoredPower: {
	DisplayName: 辅助力量
	FlavorText: 用蓄积起来的力量攻击对手。 自己的能力提高得越多， 威力就越大。
}

QuickGuard: {
	DisplayName: 快速防守
	FlavorText: 守护自己和同伴， 以防对手的先制攻击。
}

AllySwitch: {
	DisplayName: 交换场地
	FlavorText: 用神奇的力量瞬间移动， 互换自己和同伴所在的位置。
}

Scald: {
	DisplayName: 热水
	FlavorText: 向对手喷射 煮得翻滚的开水进行攻击。 有时会让对手陷入灼伤状态。
}

ShellSmash: {
	DisplayName: 破壳
	FlavorText: 打破外壳， 降低自己的防御和特防， 但大幅提高攻击、特攻和速度。
}

HealPulse: {
	DisplayName: 治愈波动
	FlavorText: 放出治愈波动， 从而回复对手 最大ＨＰ的一半。
}

Hex: {
	DisplayName: 祸不单行
	FlavorText: 接二连三地进行攻击。 对处于异常状态的对手 给予较大的伤害。
}

SkyDrop: {
	DisplayName: 自由落体
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

ShiftGear: {
	DisplayName: 换档
	FlavorText: 转动齿轮， 不仅提高自己的攻击， 还会大幅提高速度。
}

CircleThrow: {
	DisplayName: 巴投
	FlavorText: 扔飞对手，强制拉后备宝可梦上场。 如果对手为野生宝可梦， 战斗将直接结束。
}

Incinerate: {
	DisplayName: 烧尽
	FlavorText: 用火焰攻击对手。 对手携带树果等时， 会烧掉，使其不能使用。
}

Quash: {
	DisplayName: 延后
	FlavorText: 压制对手， 从而将其行动顺序放到最后。
}

Acrobatics: {
	DisplayName: 杂技
	FlavorText: 轻巧地攻击对手。 自己没有携带道具时， 会给予较大的伤害。
}

ReflectType: {
	DisplayName: 镜面属性
	FlavorText: 反射对手的属性， 让自己也变成一样的属性。
}

Retaliate: {
	DisplayName: 报仇
	FlavorText: 为倒下的同伴报仇。 如果上一回合有同伴倒下， 威力就会提高。
}

FinalGambit: {
	DisplayName: 搏命
	FlavorText: 拼命攻击对手。 虽然自己陷入濒死，但会给予对手 和自己目前ＨＰ等量的伤害。
}

Bestow: {
	DisplayName: 传递礼物
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

Inferno: {
	DisplayName: 炼狱
	FlavorText: 用烈焰包裹住对手进行攻击。 让对手陷入灼伤状态。
}

WaterPledge: {
	DisplayName: 水之誓约
	FlavorText: 用水柱进行攻击。 如果和火组合，威力就会提高， 天空中会挂上彩虹。
}

FirePledge: {
	DisplayName: 火之誓约
	FlavorText: 用火柱进行攻击。 如果和草组合，威力就会提高， 周围会变成火海。
}

GrassPledge: {
	DisplayName: 草之誓约
	FlavorText: 用草柱进行攻击。 如果和水组合，威力就会提高， 周围会变成湿地。
}

VoltSwitch: {
	DisplayName: 伏特替换
	FlavorText: 在攻击之后急速返回， 和后备宝可梦进行替换。
}

StruggleBug: {
	DisplayName: 虫之抵抗
	FlavorText: 抵抗并攻击对手。 降低对手的特攻。
}

Bulldoze: {
	DisplayName: 重踏
	FlavorText: 用力踩踏地面并攻击 自己周围所有的宝可梦。 降低对方的速度。
}

FrostBreath: {
	DisplayName: 冰息
	FlavorText: 将冰冷的气息 吹向对手进行攻击。 必定会击中要害。
}

DragonTail: {
	DisplayName: 龙尾
	FlavorText: 弹飞对手，强制拉后备宝可梦上场。 如果对手为野生宝可梦， 战斗将直接结束。
}

WorkUp: {
