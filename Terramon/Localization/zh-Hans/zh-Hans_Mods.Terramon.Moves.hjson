	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

ShoreUp: {
	DisplayName: 集沙
	FlavorText: 回复自己最大ＨＰ的一半。 在沙暴中回复得更多。
}

FirstImpression: {
	DisplayName: 迎头一击
	FlavorText: 威力很高的招式， 但只有在出场战斗时， 立刻使出才能成功。
}

BanefulBunker: {
	DisplayName: 碉堡
	FlavorText: 防住对手攻击的同时， 让接触到自己的对手中毒。
}

SpiritShackle: {
	DisplayName: 缝影
	FlavorText: 攻击的同时， 缝住对手的影子， 使其无法逃走。
}

DarkestLariat: {
	DisplayName: ＤＤ金勾臂
	FlavorText: 旋转双臂打向对手。 无视对手的能力变化， 直接给予伤害。
}

SparklingAria: {
	DisplayName: 泡影的咏叹调
	FlavorText: 随着唱歌会放出很多气球。 受到此招式攻击时， 灼伤会被治愈。
}

IceHammer: {
	DisplayName: 冰锤
	FlavorText: 挥舞强力而沉重的拳头， 给予对手伤害。 自己的速度会降低。
}

FloralHealing: {
	DisplayName: 花疗
	FlavorText: 回复对手最大ＨＰ的一半。 在青草场地时，效果会提高。
}

HighHorsepower: {
	DisplayName: 十万马力
	FlavorText: 使出全身力量， 猛攻对手。
}

StrengthSap: {
	DisplayName: 吸取力量
	FlavorText: 给自己回复和对手攻击力 相同数值的ＨＰ， 然后降低对手的攻击。
}

SolarBlade: {
	DisplayName: 日光刃
	FlavorText: 第１回合收集满满的日光， 第２回合将此力量 集中在剑上进行攻击。
}

Leafage: {
	DisplayName: 树叶
	FlavorText: 将叶片打向对手， 进行攻击。
}

Spotlight: {
	DisplayName: 聚光灯
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

ToxicThread: {
	DisplayName: 毒丝
	FlavorText: 将混有毒的丝吐向对手。 使其中毒， 从而降低对手的速度。
}

LaserFocus: {
	DisplayName: 磨砺
	FlavorText: 集中精神， 下次攻击必定会击中要害。
}

GearUp: {
	DisplayName: 辅助齿轮
	FlavorText: 启动齿轮， 提高特性为正电和负电的 宝可梦的攻击和特攻。
}

ThroatChop: {
	DisplayName: 地狱突刺
	FlavorText: 受到此招式攻击的对手， 会因为地狱般的痛苦，在２回合内， 变得无法使出声音类招式。
}

PollenPuff: {
	DisplayName: 花粉团
	FlavorText: 对敌人使用是会爆炸的团子。 对我方使用则是给予回复的团子。
}

AnchorShot: {
	DisplayName: 掷锚
	FlavorText: 将锚缠住对手进行攻击。 使对手无法逃走。
}

PsychicTerrain: {
	DisplayName: 精神场地
	FlavorText: 在５回合内，地面上的宝可梦 不会受到先制招式的攻击。 超能力属性的招式威力会提高。
}

Lunge: {
	DisplayName: 猛扑
	FlavorText: 全力猛扑对手进行攻击。 从而降低对手的攻击。
}

FireLash: {
	DisplayName: 火焰鞭
	FlavorText: 用燃烧的鞭子抽打对手。 受到攻击的对手防御会降低。
}

PowerTrip: {
	DisplayName: 嚣张
	FlavorText: 耀武扬威地攻击对手， 自己的能力提高得越多， 威力就越大。
}

BurnUp: {
	DisplayName: 燃尽
	FlavorText: 将自己全身燃烧起火焰来， 给予对手大大的伤害。 自己的火属性将会消失。
}

SpeedSwap: {
	DisplayName: 速度互换
	FlavorText: 将对手和自己的速度 进行互换。
}

SmartStrike: {
	DisplayName: 修长之角
	FlavorText: 用尖尖的角刺入对手进行攻击。 攻击必定会命中。
}

Purify: {
	DisplayName: 净化
	FlavorText: 治愈对手的异常状态。 治愈后可以回复自己的ＨＰ。
}

RevelationDance: {
	DisplayName: 觉醒之舞
	FlavorText: 全力跳舞进行攻击。 此招式的属性将 变得和自己的属性相同。
}

CoreEnforcer: {
	DisplayName: 核心惩罚者
	FlavorText: 如果给予过伤害的对手 已经结束行动， 其特性就会被消除。
}

TropKick: {
	DisplayName: 热带踢
	FlavorText: 向对手使出来自南国的火热脚踢。 从而降低对手的攻击。
}

Instruct: {
	DisplayName: 号令
	FlavorText: 向对手下达指示， 让其再次使出刚才的招式。
}

BeakBlast: {
	DisplayName: 鸟嘴加农炮
	FlavorText: 先加热鸟嘴后再进行攻击。 鸟嘴在加热时对手触碰的话， 就会使其灼伤。
}

ClangingScales: {
	DisplayName: 鳞片噪音
	FlavorText: 摩擦全身鳞片， 发出响亮的声音进行攻击。 攻击后自己的防御会降低。
}

DragonHammer: {
	DisplayName: 龙锤
	FlavorText: 将身体当作锤子， 向对手发动袭击， 给予伤害。
}

BrutalSwing: {
	DisplayName: 狂舞挥打
	FlavorText: 用自己的身体狂舞挥打， 给予对手伤害。
}

AuroraVeil: {
	DisplayName: 极光幕
	FlavorText: 在５回合内减弱 物理和特殊的伤害。 只有冰雹时才能使出。
}

