	DisplayName: 砰砰击破
	FlavorText: 无法使用这个招式。 虽然忘记之后就再也想不起来了， 但还是建议忘记这个招式。
}

DoubleIronBash: {
	DisplayName: 钢拳双击
	FlavorText: 以胸口的螺帽为中心旋转， 并连续２次挥动手臂打击对手。 有时会使对手畏缩。
}

MaxGuard: {
	DisplayName: 极巨防壁
	FlavorText: 完全抵挡 对手的攻击。 连续使出则容易失败。
}

DynamaxCannon: {
	DisplayName: 极巨炮
	FlavorText: 从核心放出光束进行攻击。 如果对手正处于极巨化状态， 则造成的伤害会变为２倍。
}

SnipeShot: {
	DisplayName: 狙击
	FlavorText: 能无视具有吸引对手招式效果的 特性或招式的影响。 可以向选定的对手进行攻击。
}

JawLock: {
	DisplayName: 紧咬不放
	FlavorText: 使双方直到一方濒死为止 无法替换宝可梦。 其中一方退场则可以解除效果。
}

StuffCheeks: {
	DisplayName: 大快朵颐
	FlavorText: 吃掉携带的树果， 大幅提高防御。
}

NoRetreat: {
	DisplayName: 背水一战
	FlavorText: 提高自己的所有能力， 但无法替换或逃走。
}

TarShot: {
	DisplayName: 沥青射击
	FlavorText: 泼洒黏糊糊的沥青， 降低对手的速度， 并且使对手的弱点变为火。
}

MagicPowder: {
	DisplayName: 魔法粉
	FlavorText: 向对手喷洒魔法粉， 使对手变为超能力属性。
}

DragonDarts: {
	DisplayName: 龙箭
	FlavorText: 让多龙梅西亚进行２次攻击。 如果对手有２只宝可梦， 则对它们各进行１次攻击。
}

Teatime: {
	DisplayName: 茶会
	FlavorText: 举办一场茶会， 场上的所有宝可梦都会 吃掉自己携带的树果。
}

Octolock: {
	DisplayName: 蛸固
	FlavorText: 让对手无法逃走。 对手被固定后， 每回合都会降低防御和特防。
}

BoltBeak: {
	DisplayName: 电喙
	FlavorText: 用带电的喙啄刺对手。 如果比对手先出手攻击， 招式的威力会变成２倍。
}

FishiousRend: {
	DisplayName: 鳃咬
	FlavorText: 用坚硬的腮咬住对手。 如果比对手先出手攻击， 招式的威力会变成２倍。
}

CourtChange: {
	DisplayName: 换场
	FlavorText: 用神奇的力量 交换双方的场地效果。
}

MaxFlare: {
	DisplayName: 极巨火爆
	FlavorText: 极巨化宝可梦使出的火属性攻击。 可在５回合内让日照变得强烈。
}

MaxFlutterby: {
	DisplayName: 极巨虫蛊
	FlavorText: 极巨化宝可梦使出的虫属性攻击。 会降低对手的特攻。
}

MaxLightning: {
	DisplayName: 极巨闪电
	FlavorText: 极巨化宝可梦使出的电属性攻击。 可在５回合内将脚下变成电气场地。
}

MaxStrike: {
	DisplayName: 极巨攻击
	FlavorText: 极巨化宝可梦使出的一般属性攻击。 会降低对手的速度。
}

MaxKnuckle: {
	DisplayName: 极巨拳斗
	FlavorText: 极巨化宝可梦使出的格斗属性攻击。 会提高我方的攻击。
}

MaxPhantasm: {
	DisplayName: 极巨幽魂
	FlavorText: 极巨化宝可梦使出的幽灵属性攻击。 会降低对手的防御。
}

MaxHailstorm: {
	DisplayName: 极巨寒冰
	FlavorText: 极巨化宝可梦 才能使出的冰属性攻击。 在５回合内会降下冰雹。
}

MaxOoze: {
	DisplayName: 极巨酸毒
	FlavorText: 极巨化宝可梦使出的毒属性攻击。 会提高我方的特攻。
}

MaxGeyser: {
	DisplayName: 极巨水流
	FlavorText: 极巨化宝可梦使出的水属性攻击。 可在５回合内降下大雨。
}

MaxAirstream: {
	DisplayName: 极巨飞冲
	FlavorText: 极巨化宝可梦使出的飞行属性攻击。 会提高我方的速度。
}

MaxStarfall: {
	DisplayName: 极巨妖精
	FlavorText: 极巨化宝可梦使出的妖精属性攻击。 可在５回合内将脚下变成薄雾场地。
}

MaxWyrmwind: {
	DisplayName: 极巨龙骑
	FlavorText: 极巨化宝可梦使出的龙属性攻击。 会降低对手的攻击。
}

MaxMindstorm: {
	DisplayName: 极巨超能
	FlavorText: 极巨化宝可梦使出的超能力属性攻击。 可在５回合内将脚下变成精神场地。
}

MaxRockfall: {
	DisplayName: 极巨岩石
	FlavorText: 极巨化宝可梦使出的岩石属性攻击。 可在５回合内卷起沙暴。
}

MaxQuake: {
	DisplayName: 极巨大地
	FlavorText: 极巨化宝可梦使出的地面属性攻击。 会提高我方的特防。
}

MaxDarkness: {
	DisplayName: 极巨恶霸
	FlavorText: 极巨化宝可梦使出的恶属性攻击。 会降低对手的特防。
}

MaxOvergrowth: {
	DisplayName: 极巨草原
	FlavorText: 极巨化宝可梦使出的草属性攻击。 可在５回合内将脚下变成青草场地。
}

MaxSteelspike: {
	DisplayName: 极巨钢铁
	FlavorText: 极巨化宝可梦使出的钢属性攻击。 会提高我方的防御。
}

ClangorousSoul: {
	DisplayName: 魂舞烈音爆
	FlavorText: 削减少许自己的ＨＰ， 使所有能力都提高。
}

BodyPress: {
	DisplayName: 扑击
	FlavorText: 用身体撞向对手进行攻击。 防御越高， 给予的伤害就越高。
}

Decorate: {
	DisplayName: 装饰
	FlavorText: 通过装饰， 大幅提高对方的 攻击和特攻。
}

DrumBeating: {
	DisplayName: 鼓击
	FlavorText: 用鼓点来控制 鼓的根部进行攻击， 从而降低对手的速度。
}

SnapTrap: {
	DisplayName: 捕兽夹
	FlavorText: 使用捕兽夹， 在４～５回合内， 夹住对手进行攻击。
}

PyroBall: {
	DisplayName: 火焰球
	FlavorText: 点燃小石子，形成火球攻击对手。 有时会使对手陷入灼伤状态。
}

BehemothBlade: {
	DisplayName: 巨兽斩
	FlavorText: 变身为巨大的剑，挥斩对手。 如果对手正处于极巨化状态， 则造成的伤害会变为２倍。
}

BehemothBash: {
	DisplayName: 巨兽弹
	FlavorText: 变身为巨大的盾，撞击对手。 如果对手正处于极巨化状态， 则造成的伤害会变为２倍。
}

AuraWheel: {
	DisplayName: 气场轮
	FlavorText: 用储存在颊囊里的能量 进行攻击，并提高自己的速度。 其属性会随着莫鲁贝可的样子而改变。
}

BreakingSwipe: {
	DisplayName: 广域破坏
	FlavorText: 用坚韧的尾巴 猛扫对手进行攻击， 从而降低对手的攻击。
}

BranchPoke: {
	DisplayName: 木枝突刺
	FlavorText: 使用尖锐的树枝 刺向对手进行攻击。
}

Overdrive: {
	DisplayName: 破音
	FlavorText: 奏响吉他和贝斯，释放出 发出巨响的剧烈震动 攻击对手。
}

AppleAcid: {
	DisplayName: 苹果酸
	FlavorText: 使用从酸苹果中提取出来的 酸性液体进行攻击。 降低对手的特防。
}

GravApple: {
	DisplayName: 万有引力
	FlavorText: 从高处落下苹果， 给予对手伤害。 可降低对手的防御。
}

SpiritBreak: {
	DisplayName: 灵魂冲击
	FlavorText: 用足以让对手一蹶不振的 气势进行攻击。 会降低对手的特攻。
}

StrangeSteam: {
	DisplayName: 神奇蒸汽
	FlavorText: 喷出烟雾攻击对手。 有时会使对手混乱。
}

LifeDew: {
	DisplayName: 生命水滴
	FlavorText: 喷洒出神奇的水， 回复自己和场上同伴的ＨＰ。
}

Obstruct: {
	DisplayName: 拦堵
	FlavorText: 完全抵挡对手的攻击。 连续使出则容易失败。 一旦触碰，防御就会大幅降低。
}

FalseSurrender: {
	DisplayName: 假跪真撞
	FlavorText: 装作低头认错的样子， 用凌乱的头发进行突刺。 攻击必定会命中。
}

MeteorAssault: {
	DisplayName: 流星突击
	FlavorText: 大力挥舞粗壮的茎进行攻击。 但同时自己也会被晃晕， 下一回合自己将无法动弹。
}

Eternabeam: {
	DisplayName: 无极光束
	FlavorText: 无极汰那变回原来的样子后， 发动的最强攻击。 下一回合自己将无法动弹。
}

SteelBeam: {
	DisplayName: 铁蹄光线
	FlavorText: 将从全身聚集的钢铁 化为光束，激烈地发射出去。 自己也会受到伤害。
}

ExpandingForce: {
	DisplayName: 广域战力
	FlavorText: 利用精神力量攻击对手。 在精神场地上威力会有所提高， 能对所有对手造成伤害。
}

SteelRoller: {
	DisplayName: 铁滚轮
	FlavorText: 在破坏场地的同时攻击对手。 如果脚下没有任何场地状态存在， 使出此招式时便会失败。
}

ScaleShot: {
	DisplayName: 鳞射
	FlavorText: 发射鳞片进行攻击。 连续攻击２～５次。 速度会提高但防御会降低。
}

MeteorBeam: {
	DisplayName: 流星光束
	FlavorText: 第１回合聚集宇宙之力提高特攻， 第２回合攻击对手。
}

ShellSideArm: {
	DisplayName: 臂贝武器
	FlavorText: 从物理攻击和特殊攻击中选择 可造成较多伤害的方式进行攻击。 有时会让对手陷入中毒状态。
}

MistyExplosion: {
	DisplayName: 薄雾炸裂
	FlavorText: 对自己周围的所有宝可梦进行攻击， 但使出后，自己会陷入濒死。 在薄雾场地上，招式威力会提高。
}

GrassyGlide: {
	DisplayName: 青草滑梯
	FlavorText: 仿佛在地面上滑行般地攻击对手。 在青草场地上， 必定能够先制攻击。
}

RisingVoltage: {
	DisplayName: 电力上升
	FlavorText: 用从地面升腾而起的电击进行攻击。 当对手处于电气场地上时， 招式威力会变成２倍。
}

TerrainPulse: {
	DisplayName: 大地波动
	FlavorText: 借助场地的力量进行攻击。 视使出招式时场地状态不同， 招式的属性和威力会有所变化。
}

SkitterSmack: {
	DisplayName: 爬击
	FlavorText: 从对手背后爬近后进行攻击。 会降低对手的特攻。
}

BurningJealousy: {
	DisplayName: 妒火
	FlavorText: 用嫉妒的能量攻击对手。 会让在该回合内能力有所提高的 宝可梦陷入灼伤状态。
}

LashOut: {
	DisplayName: 泄愤
	FlavorText: 攻击对手以发泄对其感到的恼怒情绪。 如果在该回合内自身能力遭到降低， 招式的威力会变成２倍。
}

Poltergeist: {
	DisplayName: 灵骚
	FlavorText: 操纵对手的持有物进行攻击。 当对手没有携带道具时， 使出此招式时便会失败。
}

CorrosiveGas: {
	DisplayName: 腐蚀气体
	FlavorText: 用具有强酸性的气体 包裹住自己周围所有的宝可梦， 并融化其所携带的道具。
}

Coaching: {
	DisplayName: 指导
	FlavorText: 通过进行正确合理的指导， 提高我方全员的攻击和防御。
}

FlipTurn: {
	DisplayName: 快速折返
	FlavorText: 在攻击之后急速返回， 和后备宝可梦进行替换。
}

TripleAxel: {
	DisplayName: 三旋击
	FlavorText: 连续３次踢对手进行攻击。 每踢中一次，威力就会提高。
}

DualWingbeat: {
	DisplayName: 双翼
	FlavorText: 将翅膀撞向对手进行攻击。 连续２次给予伤害。
}

ScorchingSands: {
	DisplayName: 热沙大地
	FlavorText: 将滚烫的沙子砸向对手进行攻击。 有时会让对手陷入灼伤状态。
}

JungleHealing: {
	DisplayName: 丛林治疗
	FlavorText: 与丛林融为一体， 回复自己和场上同伴的ＨＰ和状态。
}

WickedBlow: {
	DisplayName: 暗冥强击
	FlavorText: 将恶之流派修炼至大成的 猛烈一击。 必定会击中要害。
}

SurgingStrikes: {
	DisplayName: 水流连打
	FlavorText: 将水之流派修炼至大成的 仿若行云流水般的３次连击。 必定会击中要害。
}

ThunderCage: {
	DisplayName: 雷电囚笼
	FlavorText: 将对手困在 电流四溅的囚笼中， 在４～５回合内进行攻击。
}

DragonEnergy: {
	DisplayName: 巨龙威能
	FlavorText: 把生命力转换为力量攻击对手。 自己的ＨＰ越少，招式的威力越小。
}

FreezingGlare: {
	DisplayName: 冰冷视线
	FlavorText: 从双眼发射精神力量进行攻击。 有时会让对手陷入冰冻状态。
}

FieryWrath: {
	DisplayName: 怒火中烧
	FlavorText: 将愤怒转化为火焰般的气场进行攻击。 有时会使对手畏缩。
}

ThunderousKick: {
