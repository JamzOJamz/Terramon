}

PlayRough: {
	DisplayName: 嬉闹
	FlavorText: 与对手嬉闹并攻击。 有时会降低对手的攻击。
}

FairyWind: {
	DisplayName: 妖精之风
	FlavorText: 刮起妖精之风， 吹向对手进行攻击。
}

Moonblast: {
	DisplayName: 月亮之力
	FlavorText: 借用月亮的力量攻击对手。 有时会降低对手的特攻。
}

Boomburst: {
	DisplayName: 爆音波
	FlavorText: 通过震耳欲聋的爆炸声 产生的破坏力， 攻击自己周围所有的宝可梦。
}

FairyLock: {
	DisplayName: 妖精之锁
	FlavorText: 通过封锁， 下一回合所有的 宝可梦都无法逃走。
}

KingsShield: {
	DisplayName: 王者盾牌
	FlavorText: 防住对手攻击的同时， 自己变为防御姿态。 能够降低所接触到的对手的攻击。
}

PlayNice: {
	DisplayName: 和睦相处
	FlavorText: 和对手和睦相处， 使其失去战斗的气力， 从而降低对手的攻击。
}

Confide: {
	DisplayName: 密语
	FlavorText: 和对手进行密语， 使其失去集中力， 从而降低对手的特攻。
}

DiamondStorm: {
	DisplayName: 钻石风暴
	FlavorText: 掀起钻石风暴给予伤害。 有时会大幅提高自己的防御。
}

SteamEruption: {
	DisplayName: 蒸汽爆炸
	FlavorText: 将滚烫的蒸汽喷向对手。 有时会让对手灼伤。
}

HyperspaceHole: {
	DisplayName: 异次元洞
	FlavorText: 通过异次元洞， 突然出现在对手的侧面进行攻击。 还可以无视守住和看穿等招式。
}

WaterShuriken: {
	DisplayName: 飞水手里剑
	FlavorText: 用粘液制成的手里剑， 连续攻击２～５次。 必定能够先制攻击。
}

MysticalFire: {
	DisplayName: 魔法火焰
	FlavorText: 从口中喷出特别灼热的 火焰进行攻击。 降低对手的特攻。
}

SpikyShield: {
	DisplayName: 尖刺防守
	FlavorText: 防住对手攻击的同时， 削减接触到自己的对手的体力。
}

AromaticMist: {
	DisplayName: 芳香薄雾
	FlavorText: 通过神奇的芳香， 提高我方宝可梦的特防。
}

EerieImpulse: {
	DisplayName: 怪异电波
	FlavorText: 从身体放射出怪异电波， 让对手沐浴其中， 从而大幅降低其特攻。
}

VenomDrench: {
	DisplayName: 毒液陷阱
	FlavorText: 将特殊的毒液泼向对手。 对处于中毒状态的对手， 其攻击、特攻和速度都会降低。
}

Powder: {
	DisplayName: 粉尘
	FlavorText: 如果被撒到粉尘的对手 使用火招式， 则会爆炸并给予伤害。
}

Geomancy: {
	DisplayName: 大地掌控
	FlavorText: 第１回合吸收能量， 第２回合大幅提高 特攻、特防和速度。
}

MagneticFlux: {
	DisplayName: 磁场操控
	FlavorText: 通过操控磁场， 会提高特性为正电和负电的 宝可梦的防御和特防。
}

HappyHour: {
	DisplayName: 欢乐时光
	FlavorText: 如果使用欢乐时光， 战斗后得到的钱会翻倍。
}

ElectricTerrain: {
	DisplayName: 电气场地
	FlavorText: 在５回合内变成电气场地。 地面上的宝可梦将无法入眠。 电属性的招式威力还会提高。
}

DazzlingGleam: {
	DisplayName: 魔法闪耀
	FlavorText: 向对手发射强光， 并给予伤害。
}

Celebrate: {
	DisplayName: 庆祝
	FlavorText: 宝可梦为十分 开心的你庆祝。
}

HoldHands: {
	DisplayName: 牵手
	FlavorText: 我方宝可梦之间牵手。 能带来非常幸福的心情。
}

BabyDollEyes: {
	DisplayName: 圆瞳
	FlavorText: 用圆瞳凝视对手， 从而降低其攻击。 必定能够先制攻击。
}

Nuzzle: {
	DisplayName: 蹭蹭脸颊
	FlavorText: 将带电的脸颊 蹭蹭对手进行攻击。 让对手陷入麻痹状态。
}

HoldBack: {
	DisplayName: 手下留情
	FlavorText: 在攻击的时候手下留情， 从而使对手的ＨＰ 至少会留下１ＨＰ。
}

Infestation: {
	DisplayName: 死缠烂打
	FlavorText: 在４～５回合内 死缠烂打地进行攻击。 在此期间对手将无法逃走。
}

PowerUpPunch: {
	DisplayName: 增强拳
	FlavorText: 通过反复击打对手， 使自己的拳头慢慢变硬。 打中对手攻击就会提高。
}

OblivionWing: {
	DisplayName: 死亡之翼
	FlavorText: 从锁定的对手身上吸取ＨＰ。 回复给予对手 伤害的一半以上的ＨＰ。
}

ThousandArrows: {
	DisplayName: 千箭齐发
	FlavorText: 可以击中浮在空中的宝可梦。 空中的对手被击落后， 会掉到地面。
}

ThousandWaves: {
	DisplayName: 千波激荡
	FlavorText: 从地面掀起波浪进行攻击。 被掀入波浪中的对手， 将无法从战斗中逃走。
}

LandsWrath: {
	DisplayName: 大地神力
	FlavorText: 聚集大地的力量， 将此力量集中攻击对手， 并给予伤害。
}

LightOfRuin: {
	DisplayName: 破灭之光
	FlavorText: 借用永恒之花的力量， 发射出强力光线。 自己也会受到不小的伤害。
}

OriginPulse: {
	DisplayName: 根源波动
	FlavorText: 用无数青白色 且闪耀的光线攻击对手。
}

PrecipiceBlades: {
	DisplayName: 断崖之剑
	FlavorText: 将大地的力量变化为利刃 攻击对手。
}

DragonAscent: {
	DisplayName: 画龙点睛
	FlavorText: 从天空中急速下降攻击对手。 自己的防御和特防会降低。
}

HyperspaceFury: {
	DisplayName: 异次元猛攻
	FlavorText: 用许多手臂，无视对手的 守住或看穿等招式进行连续攻击， 自己的防御会降低。
}

