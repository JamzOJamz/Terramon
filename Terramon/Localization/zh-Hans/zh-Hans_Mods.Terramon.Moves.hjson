}

LeafBlade: {
	DisplayName: 叶刃
	FlavorText: 像用剑一般操纵叶片 切斩对手进行攻击。 容易击中要害。
}

DragonDance: {
	DisplayName: 龙之舞
	FlavorText: 激烈地跳起神秘 且强有力的舞蹈。 从而提高自己的攻击和速度。
}

RockBlast: {
	DisplayName: 岩石爆击
	FlavorText: 向对手发射 坚硬的岩石进行攻击。 连续攻击２～５次。
}

ShockWave: {
	DisplayName: 电击波
